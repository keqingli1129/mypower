  "entities": [
    {
      "schemaName": "kli_player",
      "displayName": "Player",
      "pluralName": "Players",
      "description": "A person who attends game nights; RSVPs and wins link back to them.",
      "iconDescription": "a single person silhouette — round head above rounded shoulders",
      "hasNotes": false,
      "primaryAttribute": {
        "schemaName": "kli_name",
        "displayName": "Name",
        "required": true
      },
      "columns": [
        {
          "schemaName": "kli_email",
          "displayName": "Email",
          "type": "Text",
          "format": "Email",
          "maxLength": 200,
          "required": "recommended",
          "description": "Where game-night invitations and confirmations are sent."
        }
      ],
      "vectorIcon": "kli_player_icon"
    },
    {
      "schemaName": "kli_boardgame",
      "displayName": "Board Game",
      "pluralName": "Board Games",
      "description": "A game in our library, with the player range and typical play time used to pick games for a night.",
      "iconDescription": "a die face showing five pips",
      "primaryAttribute": {
        "schemaName": "kli_name",
        "displayName": "Name",
        "required": true
      },
      "columns": [
        {
          "schemaName": "kli_minplayers",
          "displayName": "Minimum Players",
          "type": "Integer",
          "minValue": 1,
          "maxValue": 20,
          "required": "recommended",
          "description": "Fewest players the game supports; used to check a night has enough RSVPs."
        },
        {
          "schemaName": "kli_maxplayers",
          "displayName": "Maximum Players",
          "type": "Integer",
          "minValue": 1,
          "maxValue": 20,
          "required": "recommended",
          "description": "Most players the game supports."
        },
        {
          "schemaName": "kli_avgduration",
          "displayName": "Average Duration",
          "type": "Integer",
          "integerFormat": "Duration",
          "minValue": 0,
          "maxValue": 1440,
          "description": "Typical play time in minutes; helps plan how many games fit in a night."
        },
        {
          "schemaName": "kli_complexity",
          "displayName": "Complexity",
          "type": "Choice",
          "options": [
            "Light",
            "Medium",
            "Heavy"
          ],
          "description": "How hard the rules are to learn; drives the library-by-complexity chart."
        }
      ],
      "vectorIcon": "kli_boardgame_icon"
    },
    {
      "schemaName": "kli_gamenight",
      "displayName": "Game Night",
      "pluralName": "Game Nights",
      "description": "A scheduled evening of games. Status reason Scheduled → Played; Cancelled deactivates it. A new Scheduled night triggers the confirmation email flow.",
      "iconDescription": "a calendar page with a small star in the middle",
      "primaryAttribute": {
        "schemaName": "kli_name",
        "displayName": "Title",
        "required": true
      },
      "statusReasons": [
        {
          "label": "Scheduled",
          "state": "Active"
        },
        {
          "label": "Played",
          "state": "Active"
        },
        {
          "label": "Cancelled",
          "state": "Inactive"
        }
      ],
      "columns": [
        {
          "schemaName": "kli_startson",
          "displayName": "Starts On",
          "type": "DateTime",
          "dateFormat": "DateAndTime",
          "required": true,
          "description": "When the night starts; drives upcoming/past views and the home page countdown."
        },
        {
          "schemaName": "kli_location",
          "displayName": "Location",
          "type": "Text",
          "maxLength": 200,
          "description": "Whose house or which venue."
        }
      ],
      "vectorIcon": "kli_gamenight_icon"
    },
    {
      "schemaName": "kli_rsvp",
      "displayName": "RSVP",
      "pluralName": "RSVPs",
      "description": "One player's response for one game night (junction between Player and Game Night).",
      "iconDescription": "an envelope with a checkmark on its front",
      "primaryAttribute": {
        "schemaName": "kli_name",
        "displayName": "Name"
      },
      "columns": [
        {
          "schemaName": "kli_response",
          "displayName": "Response",
          "type": "Choice",
          "options": [
            "Going",
            "Maybe",
            "Not Going"
          ],
          "required": true,
          "description": "Whether the player is coming; Going players are the winner candidates in the Scorekeeper app."
        }
      ],
      "vectorIcon": "kli_rsvp_icon"
    },
    {
      "schemaName": "kli_gameresult",
      "displayName": "Game Result",
      "pluralName": "Game Results",
      "description": "The outcome of one game played on a game night: which game, who won, and how fun it was.",
      "iconDescription": "a trophy cup with two handles on a small base",
      "primaryAttribute": {
        "schemaName": "kli_name",
        "displayName": "Name"
      },
      "columns": [
        {
          "schemaName": "kli_funrating",
          "displayName": "Fun Rating",
          "type": "Choice",
          "options": [
            "1 - Meh",
            "2 - Okay",
            "3 - Good",
            "4 - Great",
            "5 - Brilliant"
          ],
          "description": "How much the group enjoyed the game, out of five; a Choice so it can be charted."
        },
        {
          "schemaName": "kli_note",
          "displayName": "Note",
          "type": "Memo",
          "maxLength": 2000,
          "description": "Optional comment about the game — memorable moments, rule disputes."
        }
      ],
      "vectorIcon": "kli_gameresult_icon"
    }
  ],
