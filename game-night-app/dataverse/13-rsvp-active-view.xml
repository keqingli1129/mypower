<!-- New layout + query for the RSVP "Active RSVPs" view (savedquery 9b96ad44-8b56-4f36-9a95-01d7c682310e). -->
<view>
  <layoutxml>
    <grid name="resultset" jump="kli_name" select="1" icon="1" preview="1">
      <row name="result" id="kli_rsvpid">
        <cell name="kli_name" width="200" />
        <cell name="kli_playerid" width="150" />
        <cell name="kli_gamenightid" width="175" />
        <cell name="kli_status" width="100" />
        <cell name="createdon" width="125" />
      </row>
    </grid>
  </layoutxml>
  <fetchxml>
    <fetch version="1.0" mapping="logical">
      <entity name="kli_rsvp">
        <attribute name="kli_rsvpid" />
        <attribute name="kli_name" />
        <attribute name="kli_playerid" />
        <attribute name="kli_gamenightid" />
        <attribute name="kli_status" />
        <attribute name="createdon" />
        <order attribute="kli_name" descending="false" />
        <filter type="and">
          <condition attribute="statecode" operator="eq" value="0" />
        </filter>
      </entity>
    </fetch>
  </fetchxml>
</view>
