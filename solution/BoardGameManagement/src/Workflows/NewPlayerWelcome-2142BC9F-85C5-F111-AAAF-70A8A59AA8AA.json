    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_player_is_added": {
          "metadata": {
            "operationMetadataId": "b5b74c2f-07c5-4ea8-99b4-279d5978b529"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "kli_player",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/name": "2142bc9f-85c5-f111-aaaf-70a8a59aa8aa"
            }
          }
        }
      },
      "actions": {
        "Has_email": {
          "type": "If",
          "runAfter": {},
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(triggerOutputs()?['body/kli_email'])",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Send_an_email_(V2)": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "5f6b8ec6-acb9-407b-a397-004b94dd6d11"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@triggerOutputs()?['body/kli_email']",
                  "emailMessage/Subject": "Welcome to Game Night, @{triggerOutputs()?['body/kli_name']}!",
                  "emailMessage/Body": "<p>Hi @{triggerOutputs()?['body/kli_name']}, you've been added to Game Night. See you at the next game night!</p>",
                  "emailMessage/Importance": "Normal"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": ""
  },
